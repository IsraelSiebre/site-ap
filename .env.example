# Copie para .env e substitua as duas senhas antes de executar docker compose up.
POSTGRES_DB=imobiliaria
POSTGRES_USER=imobiliaria
POSTGRES_PASSWORD=troque-esta-senha-do-banco
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-do-painel
APP_PORT=8080
# Defina true quando o acesso ao aplicativo usar HTTPS.
SESSION_COOKIE_SECURE=false
